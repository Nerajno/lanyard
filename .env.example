# Copy to .env and fill. Never commit .env.
# Canonical list lives in Architecture.md → Secrets.
#
# Names MUST keep the NUXT_ prefix: Nuxt maps env vars onto `runtimeConfig`
# in nuxt.config.ts by that prefix alone. NUXT_PUBLIC_* → runtimeConfig.public.*
# (shipped to the browser); NUXT_* → server-only. Dropping the prefix silently
# leaves the value as '' at runtime.

# --- Supabase ---
# NUXT_PUBLIC_SUPABASE_URL= Done
#NUXT_PUBLIC_SUPABASE_ANON_KEY= Done 
# Edge functions / server only. MUST NOT reach the client bundle.
#NUXT_SUPABASE_SERVICE_ROLE= Done 

# --- App ---
# Absolute origin used to build act-links in outgoing nudges. Without it the
# sender falls back to http://localhost:3000 and real messages link nowhere.
NUXT_PUBLIC_APP_URL=http://localhost:3000

# --- Twilio (SMS nudges) ---
# Requires A2P 10DLC brand + campaign approval before a production number delivers.
NUXT_TWILIO_SID=
NUXT_TWILIO_TOKEN=
NUXT_TWILIO_FROM=
# Twilio Verify service for one-time phone verification (onboarding).
NUXT_TWILIO_VERIFY_SID=

# --- Email nudges (Resend — see decisions.md) ---
NUXT_EMAIL_API_KEY=
NUXT_EMAIL_FROM=

# --- Act-links ---
# Signs the single-purpose tokens in nudge messages so the act path works
# from a phone without a fresh login. Generate: openssl rand -hex 32
NUXT_ACT_LINK_SIGNING_SECRET=

# --- Cron / scheduler ---
# Shared secret must be sent as header `x-cron-secret` when you hit /api/cron/nudge.
# (Schedule it hourly: Vercel Cron, crontab, GitHub Actions…)
NUXT_CRON_SECRET=
